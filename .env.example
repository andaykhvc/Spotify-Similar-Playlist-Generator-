# Create these values in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Public origin of this application. Do not add a trailing slash.
APP_URL=http://127.0.0.1:3000

# Generate at least 32 random bytes, for example: openssl rand -base64 48
SESSION_SECRET=

# Compliance gate. When false, no Spotify-derived data is sent to external recommenders.
EXTERNAL_RECOMMENDER_ENABLED=false

# Optional. ReccoBeats works without a key; FreqBlog is used only when this is set.
FREQBLOG_API_KEY=
